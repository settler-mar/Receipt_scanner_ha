# Copy to backend/.env and fill in. All variables use the RS_ prefix
# (see app/core/config.py). backend/.env is gitignored.

# SQLite by default; point elsewhere only for a real deployment.
RS_DATABASE_URL=sqlite:///./data/receipts.db

# Fernet key used to encrypt stored store credentials/tokens at rest.
# Generate once and keep stable — changing it invalidates everything
# already encrypted in receipts.db:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RS_SECRET_KEY=CHANGE_ME_dev_only_insecure_key_______________=

# This backend's own externally-reachable base URL. Used to build OAuth
# redirect_uri values (adapters/silpo.py, Google Drive inbox), so it must match
# what is registered with the provider. On a LAN this is the host's IP, e.g.
# http://192.168.1.50:8001 — check with `hostname -I`.
RS_BASE_URL=http://localhost:8001

# Google OAuth client for the document-inbox Drive integration (see DOCS.md).
# App-registration level, set once per deployment; the user's own refresh token
# is stored encrypted in app_settings, never here.
RS_GOOGLE_CLIENT_ID=
RS_GOOGLE_CLIENT_SECRET=
