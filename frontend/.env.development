# Left unset on purpose — src/lib/api.ts derives the backend URL from
# window.location.hostname at runtime instead, so the same build works whether
# opened as http://localhost:5173 or http://<lan-ip>:5173 from another device.
# Set VITE_API_BASE here only if the backend ever lives on a different host
# than the frontend (e.g. a real prod deployment).
